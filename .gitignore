.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# data artifacts (re-downloadable; the raw extract is in Cloud Storage)
data/*.parquet
data/*.state
data/*.json

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/.terraform.lock.hcl
terraform/terraform.tfvars

# credentials must never be committed
*.json.key
credentials.json
